        {
          "name": "DELETE Layanan (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{baseUrl}}/api/layanan/1"
          }
        }
      ]
    },
