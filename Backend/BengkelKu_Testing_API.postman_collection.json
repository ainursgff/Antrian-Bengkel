{
  "info": {
    "name": "BengkelKu Testing Cepat",
    "description": "Postman Collection untuk testing secara berurutan sesuai Sprint Backlog",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token_admin",
      "value": "MASUKKAN_TOKEN_ADMIN_DI_SINI",
      "type": "string"
    },
    {
      "key": "token_montir",
      "value": "MASUKKAN_TOKEN_MONTIR_DI_SINI",
      "type": "string"
    },
    {
      "key": "token_pelanggan",
      "value": "MASUKKAN_TOKEN_PELANGGAN_DI_SINI",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Kelola Layanan",
      "item": [
        {
          "name": "GET Layanan (Semua Role)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/layanan"
          }
        },
        {
          "name": "POST Layanan (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{baseUrl}}/api/layanan",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nama_layanan\": \"Servis Ringan Motor\",\n    \"deskripsi\": \"Servis ringan rutin untuk sepeda motor\",\n    \"estimasi_menit\": 45,\n    \"harga\": 75000,\n    \"is_aktif\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PUT Layanan (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{baseUrl}}/api/layanan/1",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nama_layanan\": \"Servis Ringan Motor Update\",\n    \"deskripsi\": \"Deskripsi update\",\n    \"estimasi_menit\": 50,\n    \"harga\": 80000,\n    \"is_aktif\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
